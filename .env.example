# Copier en .env (jamais commite) et remplacer les valeurs.
# Cle de signature des jetons JWT : Base64, 256 bits minimum (ex. : openssl rand -base64 32)
SHOPWISE_JWT_SECRET=
# Mots de passe des comptes crees au premier demarrage
SHOPWISE_ADMIN_PASSWORD=
SHOPWISE_MERCHANT_PASSWORD=
SHOPWISE_VIEWER_PASSWORD=
# Mot de passe PostgreSQL
POSTGRES_PASSWORD=
# Profil Spring : demo (donnees de demonstration) ou vide
SPRING_PROFILES_ACTIVE=demo